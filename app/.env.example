# Build-time configuration, read only through src/lib/config.ts. Copy to .env.local for local overrides.
# false = call the real API (BFF) instead of the MSW mocks
VITE_USE_MOCKS=true
# true only in the demo build (.env.demo): mocks inside the page + the app service worker (docs/guides/pwa.md)
VITE_DEMO=false
# environment label used in logs: local, dev, tst, prd
VITE_APP_ENV=local
# base URL of the API; empty = same origin
VITE_API_BASE_URL=
# external apps (Orbit, Assemble, LDM are separate apps): URLs not decided yet
VITE_ORBIT_URL=
VITE_ASSEMBLE_URL=
VITE_LDM_URL=
