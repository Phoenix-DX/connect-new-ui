{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/sw/sw.ts", "build/**/*.{ts,mjs}", "src/**/*.stories.tsx"],
  "project": ["src/**/*.{ts,tsx}", "build/**/*.{ts,mjs}"],
  "ignoreDependencies": ["ts-morph"],
  "ignoreBinaries": ["python3"],
  "ignore": [".storybook/withFlags.ts", "src/components/ui/DropdownSearch/index.ts"],
  "ignoreIssues": {
    "src/api/schema.d.ts": ["exports", "types"],
    "src/app/*.generated.ts": ["exports", "types"],
    "src/legacy/os/clientVarNames.ts": ["exports", "types"],
    "src/legacy/os/flagNames.ts": ["exports", "types"],
    "src/legacy/os/reviewMarkers.ts": ["exports", "types"]
  }
}
