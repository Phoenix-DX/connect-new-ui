{
  "name": "ubtconnect-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --mode demo && node build/zip-demo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:pwa": "vitest run --config build/e2e/vitest.config.ts",
    "lighthouse": "vitest run --config build/lighthouse/vitest.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript src/api/openapi.yaml -o src/api/schema.d.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "ci": "npm run gen:api && npm run typecheck && npm run lint && npm run format:check && npm run test && vite build"
  },
  "dependencies": {
    "@splidejs/splide": "4.1.3",
    "@tanstack/react-query": "5.101.4",
    "dompurify": "3.4.17",
    "gsap": "3.13.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "nouislider": "15.8.1",
    "openapi-fetch": "0.15.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.2",
    "sortablejs": "1.15.7",
    "wnumb": "1.2.0",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "27.4.0",
    "lighthouse": "13.4.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "storybook": "10.6.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12",
    "workbox-build": "7.4.1"
  },
  "allowScripts": {
    "esbuild": true,
    "msw": true,
    "fsevents": false
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
